{
  "schema_version": "parliament-view/1",
  "id": "thermal_blanket_first_attempt",
  "title": "Thermal blanket first attempt",
  "source": "A mountain rescue shelter has one thermal blanket. Rescuer Ellis can give the blanket to Rowan or Sasha, but not both. Both hikers are stranded in the cold, and no other rescue or warming equipment will arrive in time. If Ellis gives the blanket to Rowan, Rowan has an 80% chance of survival. If Ellis gives the blanket to Sasha, Sasha has a 60% chance of survival. The hiker who does not get the blanket will die. Before learning about Rowan, Ellis promised Sasha that Sasha would get the blanket. Whom should Ellis give the blanket to?",
  "source_sha256": "a0dba794ea1ec36c622f1dcf75f9aac5ca44cffd63e4154f5e491dee463daec7",
  "status": "INTERPRETIVE_BEAM",
  "stop": {
    "stage": "construction/admission",
    "reason": "Competing admitted worlds are not separated or invariant.",
    "kind": "epistemic_abstention"
  },
