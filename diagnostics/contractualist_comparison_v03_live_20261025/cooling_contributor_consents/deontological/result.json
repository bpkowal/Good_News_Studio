  "argument": {
    "version": "argument-support/0.1",
    "world_sha256": "6ad4ede758624e0219f89b7fd4481343d0f1b02f10359f3aa0b8a26baccf01ed",
    "evidence": [
      {
        "ref": "SCENE",
        "kind": "EXACT_SCENARIO",
        "value": "During a heat wave, a council has funds for one of three technically feasible cooling plans. Plan A cools twenty households but requires demolishing Mira's occupied home, leaving her without housing; she refuses. Plan B cools twelve of those same households and displaces nobody. Plan C cools Jo's home, which has the greatest heat exposure of any home in this case, but requires closing Sal's only shop for eight weeks without compensation, depriving Sal of income during that period. Sal freely agrees to that closure after being informed of those consequences, without pressure. Jo's home is not cooled by A or B. Mira, Jo, and Sal are not members of the twenty households. No additional cooling, relocation, or compensation plan is available in this exercise. The text stipulates these effects, not total welfare scores or a ranking of whose overall position is worst. Which plan should the council adopt?"
      }
    ],
    "issue_id": "cooling_contributor_consents:deontological",
