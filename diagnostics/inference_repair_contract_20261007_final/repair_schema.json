    "conditional_assumptions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 1000
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "provenance": {
