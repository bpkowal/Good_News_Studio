          "enum": [
            "EXPECTED_SURVIVORS",
            "TOTAL_WELFARE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "CONDITIONAL",
            "UNRESOLVED",
            "WITHDRAWN"
          ]
        },
        "action_id": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "NONE"
          ]
        }
      },
      "required": [
