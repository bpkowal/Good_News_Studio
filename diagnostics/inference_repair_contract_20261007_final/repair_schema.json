    "challenged_inference_id": {
      "type": "string",
      "maxLength": 1000
    },
    "repair_operation": {
      "type": "string",
      "enum": [
        "DEFEND",
        "CONDITIONALIZE",
        "WEAKEN",
        "RETRACT"
      ]
