          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "maxItems": 16
          }
        },
        "required": [
          "id",
          "text",
          "provenance",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "conditional_preference": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "enum": [
