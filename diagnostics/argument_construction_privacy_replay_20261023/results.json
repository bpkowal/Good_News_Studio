        "raw_proposal": {
          "label": "Disclose-Only-What-is-Needed",
          "statements": [
            {
              "kind": "SOURCE_RULE",
              "text": "\"A clinic confidentiality policy tells Mara not to disclose a patient's medical record without consent.\"",
              "polarity": "AFFIRMED",
              "modality": "ASSERTED",
              "hypothesis_ids": [],
              "citations": [
                {
                  "evidence_id": "SCENE",
                  "value_path": "",
                  "quote": "A clinic confidentiality policy tells Mara not to disclose a patient's medical record without consent."
                }
              ],
              "handle": "r_policy"
            },
            {
              "kind": "SOURCE_RULE",
              "text": "\"Sharing the allergy entry only with that physician may prevent a dangerous reaction, but success is not guaranteed.\"",
              "polarity": "AFFIRMED",
              "modality": "ASSERTED",
              "hypothesis_ids": [],
              "citations": [
                {
                  "evidence_id": "SCENE",
                  "value_path": "",
                  "quote": "Sharing the allergy entry only with that physician may prevent a dangerous reaction, but success is not guaranteed."
                }
              ],
              "handle": "r_emergency"
            },
            {
              "kind": "MAXIM",
              "text": "If disclosing the minimum information to a treating physician is the only timely way to avert serious and otherwise unavoidable harm to the same patient, then one ought to disclose exactly that minimum.",
              "polarity": "AFFIRMED",
              "modality": "ASSERTED",
              "hypothesis_ids": [],
              "citations": [],
              "handle": "m_minimum_disclose"
            },
            {
              "kind": "NORMATIVE_PREMISE",
              "text": "Preventing an imminent, serious harm to the patient has moral priority over keeping information confidential, provided the disclosure is strictly limited to what is necessary.",
              "polarity": "AFFIRMED",
              "modality": "ASSERTED",
              "hypothesis_ids": [],
              "citations": [],
              "handle": "p_priority"
            },
            {
              "kind": "NORMATIVE_PREMISE",
              "text": "One ought to obey institutional confidentiality policies unless a higher-priority moral duty overrides them.",
              "polarity": "AFFIRMED",
              "modality": "ASSERTED",
              "hypothesis_ids": [],
              "citations": [],
              "handle": "p_policy_duty"
            },
            {
              "kind": "NORMATIVE_JUDGMENT",
              "text": "Therefore, Mara ought to share only the allergy entry with the on-call physician.",
              "polarity": "AFFIRMED",
              "modality": "ASSERTED",
              "hypothesis_ids": [],
              "citations": [],
              "handle": "c_share"
            }
          ],
